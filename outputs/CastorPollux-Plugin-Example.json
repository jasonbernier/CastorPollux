{
  "schema": 1,
  "id": "example-policy",
  "version": "1.0",
  "enabled": false,
  "flow": {
    "sources": [
      {
        "name": "MyInputApi",
        "output": 0
      }
    ],
    "sinks": [
      "MyRiskyApi"
    ],
    "sanitizers": [
      {
        "name": "MySanitizer",
        "output": "return"
      }
    ]
